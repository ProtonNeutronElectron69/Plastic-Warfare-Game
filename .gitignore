# ---------------------------------------------------------------------------
# Files that are GENERATED, not written by hand. They are rebuilt on demand from
# plastic-warfare.html, so keeping them out of the repo means there is exactly
# one copy of the game and no way to edit the wrong one by mistake.
# ---------------------------------------------------------------------------

# The game's script block, extracted for the headless tests (harness/build.sh)
harness/game.js

# A copy of plastic-warfare.html, refreshed by build.sh so the source-text lints
# always read the CURRENT game rather than a stale copy that drifted behind it
harness/pw.html

# The assembled test bundles that run.sh / seg.sh concatenate before running
harness/harness.js
harness/harness_ms.js
harness/harness_full.js
harness/seg1.js
harness/seg2a.js
harness/seg2b.js
harness/seg2c.js
harness/seg3.js
harness/.seg*.out
harness/rc.js
harness/rc*.js
harness/tri.js
harness/sim.js
harness/simrep.js
harness/probev89.js

# Battle-report runs (harness/sim.sh). Every match re-runs from its seed, so the
# results are reproducible rather than worth committing.
harness/sim_out/

# Air-probe runs (harness/probe_v89.sh). Same deal as sim_out: re-runs from seeds.
harness/probe_out/
harness/cut_v*.json

# Texture pipeline intermediates (tools/dump_base_v95.js step one). The finished
# textures in assets/img/ are committed; these 6x base renders are rebuilt from
# the game itself whenever the pipeline runs.
tools/_base_v95/

# ---------------------------------------------------------------------------
# Ordinary clutter your computer creates on its own
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~

# If Node packages ever get installed here (e.g. for the canvas render tests).
# package.json joined the list at v86: npm i writes one, the render tails are a
# manual "npm i @napi-rs/canvas" step by design, and a committed manifest would
# quietly turn that into a dependency of the repo.
node_modules/
package-lock.json
package.json

# Python import cache from the texture tools
tools/__pycache__/
